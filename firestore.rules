rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /userStats/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared public demo sandbox — its data is reset by
    // FirestoreActions.updateDemoData(), so any authenticated session
    // (including anonymous) may read/write it.
    match /users/demoUser/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /userStats/demoUser/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}